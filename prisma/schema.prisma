// ─────────────────────────────────────────────────────────────
// AI Interviewer — Database Schema
// ─────────────────────────────────────────────────────────────

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ─────────────────────────────────────────────────────────────
// ENUMS
// ─────────────────────────────────────────────────────────────

enum Role {
  CANDIDATE
  ADMIN
}

enum InterviewStatus {
  PENDING
  IN_PROGRESS
  COMPLETED
  CANCELLED
}

enum Difficulty {
  EASY
  MEDIUM
  HARD
}

enum QuestionType {
  BEHAVIORAL
  TECHNICAL
  CODING
  SYSTEM_DESIGN
}

enum ActivityType {
  TAB_SWITCH
  COPY
  PASTE
  FULLSCREEN_EXIT
  WINDOW_BLUR
  SUSPICIOUS_TYPING
  HINT_REQUESTED
}

enum InvitationStatus {
  INVITED
  STARTED
  COMPLETED
  EXPIRED
  REVOKED
}

enum CandidateDecision {
  UNDECIDED
  ADVANCE
  HOLD
  REJECT
}

enum InterviewMode {
  PRACTICE
  ASSESSMENT
}

enum ReportStatus {
  PENDING
  GENERATING
  READY
  FAILED
}

// ─────────────────────────────────────────────────────────────
// MODELS
// ─────────────────────────────────────────────────────────────

/// Registered users of the platform
model User {
  id            String    @id @default(cuid())
  email         String    @unique
  name          String?
  image         String?   // Avatar URL (from OAuth provider)
  passwordHash  String?   // Null if using OAuth only
  role          Role      @default(CANDIDATE)
  isActive      Boolean   @default(true)
  emailVerified DateTime?

  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  // Relations
  accounts             Account[]
  sessions             Session[]
  interviews           Interview[]
  createdTemplates     InterviewTemplate[]
  createdQuestions     BankQuestion[]
  sentInvitations      InterviewInvitation[]
  decisionAuditLogs    DecisionAuditLog[]
  deletionRequests     DataDeletionRequest[]

  @@map("users")
}

model Account {
  id                String  @id @default(cuid())
  userId            String  @map("user_id")
  type              String
  provider          String
  providerAccountId String  @map("provider_account_id")
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@map("accounts")
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique @map("session_token")
  userId       String   @map("user_id")
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("sessions")
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
  @@map("verification_tokens")
}

/// Reusable interview template created by Admins
model InterviewTemplate {
  id               String       @id @default(cuid())
  title            String
  jobRole          String
  description      String?
  duration         Int          @default(45) // In minutes
  questionCount    Int          @default(5)
  difficulty       Difficulty   @default(MEDIUM)
  stages           String[]     // e.g. ["SCREENING", "CODING", "BEHAVIORAL"]
  rubricWeights    Json?        // e.g. { technical: 40, problemSolving: 30, communication: 20, codeQuality: 10 }
  proctoringPolicy Json?        // e.g. { tabSwitchLimit: 3, blockPaste: true, fullscreenRequired: true }

  createdById      String
  createdBy        User         @relation(fields: [createdById], references: [id], onDelete: Cascade)

  createdAt        DateTime     @default(now())
  updatedAt        DateTime     @updatedAt

  // Relations
  interviews       Interview[]
  invitations      InterviewInvitation[]

  @@map("interview_templates")
}

/// Curated question bank with tags, starter code, and test cases
model BankQuestion {
  id             String       @id @default(cuid())
  title          String
  content        String       @db.Text
  type           QuestionType
  difficulty     Difficulty   @default(MEDIUM)
  tags           String[]
  expectedTopics String[]
  sampleCode     String?      @db.Text
  starterCode    Json?        // e.g. { javascript: "...", python: "..." }
  testCases      Json?        // e.g. [{ input, expectedOutput, isHidden, explanation }]
  rubric         Json?        // Scoring criteria
  hints          String[]     @default([])

  createdById    String?
  createdBy      User?        @relation(fields: [createdById], references: [id], onDelete: SetNull)

  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  @@map("bank_questions")
}

/// Candidate interview invitations with single-use expiring links
model InterviewInvitation {
  id             String           @id @default(cuid())
  token          String           @unique
  candidateEmail String
  candidateName  String?
  jobRole        String
  difficulty     Difficulty       @default(MEDIUM)
  status         InvitationStatus @default(INVITED)
  expiresAt      DateTime

  invitedById    String
  invitedBy      User             @relation(fields: [invitedById], references: [id], onDelete: Cascade)

  templateId     String?
  template       InterviewTemplate? @relation(fields: [templateId], references: [id], onDelete: SetNull)

  interviewId    String?          @unique
  interview      Interview?       @relation(fields: [interviewId], references: [id], onDelete: SetNull)

  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt

  @@index([candidateEmail])
  @@index([status])
  @@map("interview_invitations")
}

/// A single interview session
model Interview {
  id              String            @id @default(cuid())
  title           String            // e.g. "Senior Frontend Developer Interview"
  jobRole         String            // e.g. "Frontend Developer", "Backend Engineer"
  difficulty      Difficulty        @default(MEDIUM)
  topics          String[]          // e.g. ["React", "TypeScript", "System Design"]
  status          InterviewStatus   @default(PENDING)
  totalScore      Float?            // Overall score (0-100), set after completion

  // Human recruiter override & review
  humanDecision   CandidateDecision @default(UNDECIDED)
  humanScore      Float?
  humanNotes      String?           @db.Text
  reviewedAt      DateTime?
  reviewedById    String?

  // Recruiter settings & assessment duration
  durationMinutes  Int               @default(30)
  extraTimeMinutes Int               @default(0)
  mode             InterviewMode     @default(ASSESSMENT)
  reportStatus     ReportStatus      @default(PENDING)
  transcript       Json?             // Conversational transcript (STT/audio turns)
  feedbackReleased Boolean           @default(false)
  hintsUsed        Int               @default(0)

  // Analytics & cost tracking
  durationSeconds Int?
  tokenCount      Int               @default(0)
  estimatedCost   Float             @default(0.0)

  startedAt       DateTime?
  completedAt     DateTime?
  createdAt       DateTime          @default(now())
  updatedAt       DateTime          @updatedAt

  // Relations
  userId          String
  user            User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  templateId      String?
  template        InterviewTemplate? @relation(fields: [templateId], references: [id], onDelete: SetNull)
  invitation      InterviewInvitation?
  questions       Question[]
  report          Report?
  activities      ActivityEvent[]
  auditLogs       DecisionAuditLog[]

  @@index([userId])
  @@index([status])
  @@index([humanDecision])
  @@map("interviews")
}

/// Audit log for recruiter actions and human overrides
model DecisionAuditLog {
  id               String            @id @default(cuid())
  interviewId      String
  interview        Interview         @relation(fields: [interviewId], references: [id], onDelete: Cascade)

  adminId          String
  admin            User              @relation(fields: [adminId], references: [id], onDelete: Cascade)

  action           String            // e.g. "DECISION_SET", "SCORE_OVERRIDE", "NOTE_ADDED"
  originalScore    Float?
  overrideScore    Float?
  previousDecision CandidateDecision?
  newDecision      CandidateDecision?
  notes            String?           @db.Text

  createdAt        DateTime          @default(now())

  @@index([interviewId])
  @@index([adminId])
  @@map("decision_audit_logs")
}

/// A single question asked during an interview
model Question {
  id             String       @id @default(cuid())
  orderIndex     Int          // Position in the interview (1, 2, 3...)
  type           QuestionType
  content        String       @db.Text
  context        String?      @db.Text
  expectedTopics String[]
  hints          String[]     @default([])
  hintsRevealed  Int          @default(0)
  starterCode    Json?        // e.g. { javascript: "..." }
  testCases      Json?        // e.g. [{ input, expectedOutput, isHidden, explanation }]

  createdAt      DateTime     @default(now())

  // Relations
  interviewId    String
  interview      Interview    @relation(fields: [interviewId], references: [id], onDelete: Cascade)
  response       Response?

  @@unique([interviewId, orderIndex])
  @@index([interviewId])
  @@map("questions")
}

/// The candidate's response to a question
model Response {
  id           String      @id @default(cuid())
  content      String      @db.Text // The candidate's answer (text)
  code         String?     @db.Text // Code submitted (for coding questions)
  language     String?     // Programming language used
  durationMs   Int?        // Time taken to answer in milliseconds
  hintsUsed    Int         @default(0) // Number of hints used (0-3)
  penaltyScore Float       @default(0) // Scoring penalty from hints

  createdAt    DateTime    @default(now())

  // Relations
  questionId String      @unique
  question   Question    @relation(fields: [questionId], references: [id], onDelete: Cascade)
  evaluation Evaluation?
  followUps  FollowUp[]

  @@map("responses")
}

/// Follow-up question turns for an interview response
model FollowUp {
  id         String   @id @default(cuid())
  prompt     String   @db.Text
  answer     String   @db.Text
  createdAt  DateTime @default(now())

  responseId String
  response   Response @relation(fields: [responseId], references: [id], onDelete: Cascade)

  @@index([responseId])
  @@map("follow_ups")
}

/// AI evaluation of a candidate's response
model Evaluation {
  id              String   @id @default(cuid())
  score           Float    // Score for this response (0-10)
  feedback        String   @db.Text // Detailed feedback text
  strengths       String[] // What the candidate did well
  weaknesses      String[] // Areas for improvement
  followUpAsked   Boolean  @default(false)

  // Version stamping & reproducibility
  modelName       String?  // e.g. "gpt-4o", "gemini-1.5-pro"
  promptVersion   String?  // e.g. "v1.2.0"

  // Code-specific evaluation (nullable for non-coding questions)
  codeCorrectness Float?   // 0-10
  codeEfficiency  Float?   // 0-10
  codeReadability Float?   // 0-10
  testCasesPassed Int?     // Number of test cases passed
  testCasesTotal  Int?     // Total number of test cases

  createdAt       DateTime @default(now())

  // Relations
  responseId      String   @unique
  response        Response @relation(fields: [responseId], references: [id], onDelete: Cascade)

  @@map("evaluations")
}

/// Comprehensive interview report generated after completion
model Report {
  id                  String   @id @default(cuid())
  overallScore        Float    // 0-100
  summary             String   @db.Text
  technicalScore      Float    // Technical knowledge score (0-100)
  communicationScore  Float    // Communication quality (0-100)
  problemSolvingScore Float    // Problem-solving ability (0-100)
  codeQualityScore    Float?   // Code quality (0-100), null if no coding

  // Version stamping & reproducibility
  modelName           String?
  promptVersion       String?

  strengths           String[] // Overall strengths
  weaknesses          String[] // Overall weaknesses
  recommendations     String[] // Actionable improvement suggestions
  detailedFeedback    Json     // Full structured feedback from LLM
  pdfUrl              String?  // Generated PDF report download URL

  createdAt           DateTime @default(now())

  // Relations
  interviewId         String   @unique
  interview           Interview @relation(fields: [interviewId], references: [id], onDelete: Cascade)

  @@map("reports")
}

/// Activity events tracked during an interview (for monitoring)
model ActivityEvent {
  id          String       @id @default(cuid())
  type        ActivityType
  description String?
  metadata    Json?
  timestamp   DateTime     @default(now())

  // Relations
  interviewId String
  interview   Interview    @relation(fields: [interviewId], references: [id], onDelete: Cascade)

  @@index([interviewId])
  @@index([timestamp])
  @@map("activity_events")
}

/// Candidate data deletion requests (GDPR / Privacy compliance)
model DataDeletionRequest {
  id        String   @id @default(cuid())
  userId    String
  userEmail String
  reason    String?  @db.Text
  status    String   @default("PENDING") // PENDING, PROCESSING, COMPLETED
  createdAt DateTime @default(now())

  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("data_deletion_requests")
}
