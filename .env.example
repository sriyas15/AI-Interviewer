# ─────────────────────────────────────────────────────────────
# Environment Variables
# ─────────────────────────────────────────────────────────────
# Copy this file to .env.local and fill in the values.
# NEVER commit .env.local to git!
# ─────────────────────────────────────────────────────────────

# ─── Database ─────────────────────────────────────────────────
# PostgreSQL connection string
# Format: postgresql://USER:PASSWORD@HOST:PORT/DATABASE
DATABASE_URL="postgresql://postgres:password@localhost:5432/ai_interviewer"

# ─── Authentication ───────────────────────────────────────────
# Generate with: openssl rand -base64 32
NEXTAUTH_SECRET="your-secret-here-change-this"
NEXTAUTH_URL="http://localhost:3000"

# Google OAuth (optional — get from console.cloud.google.com)
# GOOGLE_CLIENT_ID=""
# GOOGLE_CLIENT_SECRET=""

# ─── AI / LLM ────────────────────────────────────────────────
# OpenAI API key (get from platform.openai.com)
# OPENAI_API_KEY=""

# Google Gemini API key (get from aistudio.google.com)
# GEMINI_API_KEY=""

# ─── Code Execution ──────────────────────────────────────────
# Judge0 API (get from judge0.com or self-host)
# JUDGE0_API_URL="https://judge0-ce.p.rapidapi.com"
# JUDGE0_API_KEY=""

# ─── Speech Services ─────────────────────────────────────────
# Deepgram (get from console.deepgram.com)
# DEEPGRAM_API_KEY=""
